<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Payment Wizard View -->
    <record id="view_library_fine_payment_wizard_form" model="ir.ui.view">
        <field name="name">library.fine.payment.wizard.form</field>
        <field name="model">library.fine.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Collect Fine Payment">
                <sheet>
                    <group>
                        <group>
                            <field name="fine_id" readonly="1"/>
                            <field name="member_id" readonly="1"/>
                            <field name="payment_date"/>
                        </group>
                        <group>
                            <field name="fine_amount" readonly="1" widget="monetary"/>
                            <field name="paid_amount" readonly="1" widget="monetary"/>
                            <field name="remaining_amount" readonly="1" widget="monetary"/>
                        </group>
                    </group>

                    <separator string="Payment Information"/>
                    <group>
                        <group>
                            <field name="amount" widget="monetary"/>
                            <field name="payment_method"/>
                        </group>
                        <group>
                            <field name="payment_reference"/>
                        </group>
                    </group>

                    <separator string="Notes"/>
                    <field name="notes" placeholder="Add any additional notes about this payment..."/>
                </sheet>

                <footer>
                    <button name="action_collect_payment"
                            type="object"
                            string="Collect Payment"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Waive Wizard View -->
    <record id="view_library_fine_waive_wizard_form" model="ir.ui.view">
        <field name="name">library.fine.waive.wizard.form</field>
        <field name="model">library.fine.waive.wizard</field>
        <field name="arch" type="xml">
            <form string="Waive Fine">
                <sheet>
                    <group>
                        <group>
                            <field name="fine_id" readonly="1"/>
                            <field name="member_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="fine_amount" readonly="1" widget="monetary"/>
                            <field name="remaining_amount" readonly="1" widget="monetary"/>
                            <field name="waive_date"/>
                        </group>
                    </group>

                    <separator string="Waive Reason"/>
                    <field name="waive_reason"
                           placeholder="Please provide a detailed reason for waiving this fine..."
                           required="1"/>

                    <div class="alert alert-warning" role="alert">
                        <strong>Warning:</strong> This action will permanently waive the fine and cannot be undone.
                    </div>
                </sheet>

                <footer>
                    <button name="action_waive_fine"
                            type="object"
                            string="Waive Fine"
                            class="btn-primary"
                            confirm="Are you sure you want to waive this fine? This action cannot be undone."/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Actions for Wizards -->
    <record id="action_library_fine_payment_wizard" model="ir.actions.act_window">
        <field name="name">Collect Fine Payment</field>
        <field name="res_model">library.fine.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_library_fine_waive_wizard" model="ir.actions.act_window">
        <field name="name">Waive Fine</field>
        <field name="res_model">library.fine.waive.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

     <menuitem id="menu_library_book_fine_wizard"
                  name="fine wizard"
                  parent="menu_library_root"
                  action="action_library_fine_payment_wizard"
                  sequence="1"/>


</odoo>