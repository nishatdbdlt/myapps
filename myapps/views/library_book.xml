<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Book Form View -->
        <record id="view_library_book_form" model="ir.ui.view">
            <field name="name">library.book.form</field>
            <field name="model">library.book</field>
            <field name="arch" type="xml">
                <form string="Book">
                    <header>
                        <button name="action_borrow_book" type="object"
                                string="Borrow" class="oe_highlight"/>
                        <button name="action_return_book" type="object"
                                string="Return" class="oe_highlight"/>
                        <button name="action_reserve_book" type="object"
                                string="Reserve"/>
                        <button name="action_make_available" type="object"
                                string="Make Available"/>
                        <button name="action_mark_damaged" type="object"
                                string="Mark Damaged"
                                confirm="Are you sure you want to mark this book as damaged?"/>
                        <button name="action_mark_lost" type="object"
                                string="Mark Lost"
                                confirm="Are you sure you want to mark this book as lost?"/>
                        <field name="state" widget="statusbar" statusbar_visible="available,borrowed,reserved"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
<!--                           <button class="oe_stat_button" type="object"-->
<!--                                   name="action_view_borrow_history" icon="fa-history">-->
<!--                               <div class="o_field_widget o_stat_info">-->

<!--                                  <span class="o_stat_value">&ndash;&gt;-->
<!--                                      <field name="total_borrowed"/>-->
<!--                                   </span>&ndash;&gt;-->
<!--                                   <span class="o_stat_text">Times Borrowed</span>-->
<!--                                </div>-->
<!--                           </button>-->
<!--                            <button class="oe_stat_button" type="object"-->
<!--                                    name="action_view_current_borrower" icon="fa-user"/>-->


                        </div>

                          <widget name="web_ribbon" title="Borrowed"
                                   bg_color="bg-danger"/>
                        <widget name="web_ribbon" title="Reserved"
                                    bg_color="bg-warning"/>
                          <widget name="web_ribbon" title="Damaged"
                               bg_color="bg-dark"   />

                        <field name="book_cover" widget="image" class="oe_avatar"/>

                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name" placeholder="Book Title"/></h1>
                            <h3>
                                <field name="author_id" placeholder="Select Author"/>
                            </h3>
                        </div>

                        <group>
                            <group name="basic_info">
                                <field name="book_code" readonly="1"/>
                                <field name="isbn"/>
                                <field name="category_id"/>
?                                <field name="language"/>
                                <field name="current_borrower_id"/>
                            </group>
                            <group name="publication_info">
                                <field name="edition"/>
                                <field name="pages"/>
                                <field name="publication_date"/>
                                <field name="price"/>
                                <field name="rack_location"/>
                                <field name="barcode"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Description" name="description">
                                <field name="description" placeholder="Book description and summary..."/>
                            </page>
                            <page string="Borrowing History" name="borrowing">
                                <field name="borrow_ids">
                                    <tree decoration-info="state=='borrowed'"
                                          decoration-danger="state=='overdue'"
                                          decoration-muted="state in ['returned','cancelled']">
                                        <field name="name"/>
                                        <field name="member_id"/>
                                        <field name="borrow_date"/>
                                        <field name="due_date"/>
                                        <field name="actual_return_date"/>
                                        <field name="state" widget="badge"/>
                                        <field name="overdue_days"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Returns" name="returns">
                                <field name="return_ids">
                                    <tree decoration-warning="is_late==True">
                                        <field name="name"/>
                                        <field name="member_id"/>
                                        <field name="return_date"/>
                                        <field name="condition_on_return"/>
                                        <field name="is_late"/>
                                        <field name="overdue_days" />
                                        <field name="fine_amount" />
                                        <field name="state" widget="badge"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Internal Notes" name="notes">
                                <field name="notes" placeholder="Internal notes about this book..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Book Tree View -->
        <record id="view_library_book_tree" model="ir.ui.view">
            <field name="name">library.book.tree</field>
            <field name="model">library.book</field>
            <field name="arch" type="xml">
                <tree string="Books" decoration-info="state=='available'"
                      decoration-danger="state=='borrowed'"
                      decoration-warning="state=='reserved'"
                      decoration-muted="state in ['damaged','lost']">
                    <field name="book_cover" widget="image" optional="show"/>
                    <field name="book_code"/>
                    <field name="name"/>
                    <field name="author_id"/>
                    <field name="category_id"/>
                    <field name="isbn" optional="hide"/>
                    <field name="language" optional="hide"/>
                    <field name="rack_location" optional="show"/>
                    <field name="current_borrower_id" optional="show"/>
                    <field name="total_borrowed" optional="show"/>
                    <field name="state" widget="badge"/>
                    <field name="active" invisible="1"/>
                </tree>
            </field>
        </record>

        <!-- Book Kanban View -->
        <record id="view_library_book_kanban" model="ir.ui.view">
            <field name="name">library.book.kanban</field>
            <field name="model">library.book</field>
            <field name="arch" type="xml">
                <kanban default_group_by="category_id" class="o_kanban_mobile">
                    <field name="book_cover"/>
                    <field name="name"/>
                    <field name="author_id"/>
                    <field name="state"/>
                    <field name="category_id"/>
                    <field name="total_borrowed"/>
                    <field name="average_rating"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="o_kanban_image">
                                    <img t-att-src="kanban_image('library.book', 'book_cover', record.id.raw_value)"
                                         alt="Book Cover" class="o_kanban_image_fill_top"/>
                                </div>
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        by <field name="author_id"/>
                                    </div>
                                    <div class="oe_kanban_bottom_left">
                                        <field name="state" widget="label_selection"
                                               options="{'classes': {'available': 'success', 'borrowed': 'danger', 'reserved': 'warning', 'damaged': 'dark', 'lost': 'dark'}}"/>
                                    </div>
<!--                                    <div class="oe_kanban_bottom_right">-->
<!--                                        <span class="badge badge-pill">-->
<!--                                            <i class="fa fa-refresh"/> <field name="total_borrowed"/>-->
<!--                                        </span>-->
<!--                                        <span class="badge badge-pill" t-if="record.average_rating.raw_value > 0">-->
<!--                                            <i class="fa fa-star"/> <field name="average_rating"/>-->
<!--                                        </span>-->
<!--                                    </div>-->
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Book Search View -->
        <record id="view_library_book_search" model="ir.ui.view">
            <field name="name">library.book.search</field>
            <field name="model">library.book</field>
            <field name="arch" type="xml">
                <search string="Search Books">
                    <field name="name" string="Title/ISBN/Barcode"
                           filter_domain="['|','|','|',('name','ilike',self),('isbn','ilike',self),('barcode','ilike',self),('book_code','ilike',self)]"/>
                    <field name="author_id"/>
                    <field name="category_id"/>
                    <field name="publisher_id"/>
                    <field name="rack_location"/>

                    <filter string="Available" name="available" domain="[('state','=','available')]"/>
                    <filter string="Borrowed" name="borrowed" domain="[('state','=','borrowed')]"/>
                    <filter string="Reserved" name="reserved" domain="[('state','=','reserved')]"/>
                    <filter string="Damaged" name="damaged" domain="[('state','=','damaged')]"/>
                    <filter string="Lost" name="lost" domain="[('state','=','lost')]"/>

                    <separator/>
                    <filter string="Bengali Books" name="bengali" domain="[('language','=','bn')]"/>
                    <filter string="English Books" name="english" domain="[('language','=','en')]"/>

<!--                    <separator/>-->
<!--                    <filter string="Popular Books" name="popular" domain="[('total_borrowed','>',5)]"/>-->
<!--                    <filter string="Highly Rated" name="highly_rated" domain="[('average_Ff','>=',4)]"/>-->

                    <separator/>
                    <filter string="Active" name="active" domain="[('active','=',True)]"/>
                    <filter string="Archived" name="archived" domain="[('active','=',False)]"/>

                    <group expand="0" string="Group By">
                        <filter string="Category" name="group_category" domain="[]" context="{'group_by':'category_id'}"/>
                        <filter string="Author" name="group_author" domain="[]" context="{'group_by':'author_id'}"/>
                        <filter string="Publisher" name="group_publisher" domain="[]" context="{'group_by':'publisher_id'}"/>
                        <filter string="Status" name="group_status" domain="[]" context="{'group_by':'state'}"/>
                        <filter string="Language" name="group_language" domain="[]" context="{'group_by':'language'}"/>
                        <filter string="Rack Location" name="group_rack" domain="[]" context="{'group_by':'rack_location'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Book Actions -->
        <record id="action_library_book" model="ir.actions.act_window">
            <field name="name">Books</field>
            <field name="res_model">library.book</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="context">{'search_default_available': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add your first book to the library!
                </p>
                <p>
                    Start by adding books to your library collection. You can add books manually
                    or import them from a spreadsheet.
                </p>
            </field>
        </record>

        <!-- Available Books Action -->
        <record id="action_library_book_available" model="ir.actions.act_window">
            <field name="name">Available Books</field>
            <field name="res_model">library.book</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="domain">[('state','=','available')]</field>
            <field name="context">{'default_state': 'available'}</field>
        </record>

        <!-- Borrowed Books Action -->
        <record id="action_library_book_borrowed" model="ir.actions.act_window">
            <field name="name">Borrowed Books</field>
            <field name="res_model">library.book</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('state','=','borrowed')]</field>
        </record>

        <!-- Book by Category Action -->
        <record id="action_library_book_by_category" model="ir.actions.act_window">
            <field name="name">Books by Category</field>
            <field name="res_model">library.book</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="context">{'search_default_group_category': 1}</field>
        </record>


    <menuitem id="menu_library_books"
                  name="Books"
                  parent="menu_library_root"
                  sequence="10"/>

        <menuitem id="menu_library_book_list"
                  name="All Books"
                  parent="menu_library_books"
                  action="action_library_book"
                  sequence="1"/>









