<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Borrow Form View -->
        <record id="view_library_borrow_form" model="ir.ui.view">
            <field name="name">library.borrow.form</field>
            <field name="model">library.borrow</field>
            <field name="arch" type="xml">
                <form string="Book Borrowing">
                    <header>
                        <button name="action_confirm_borrow" type="object"
                                string="Confirm Borrowing" class="oe_highlight"/>
                        <button name="action_return_book" type="object"
                                string="Return Book" class="oe_highlight"/>
                        <button name="action_extend_due_date" type="object"
                                string="Extend Due Date"/>
                        <button name="action_mark_lost" type="object"
                                string="Mark as Lost"/>
                        <button name="action_cancel" type="object"
                                string="Cancel"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,borrowed,returned"/>
                    </header>
                    <sheet>

                        <!-- Stat Buttons -->
<!--                        <button class="oe_stat_button" type="object"-->
<!--                                name="action_view_book_details" icon="fa-book">-->
<!--                            <div class="o_field_widget o_stat_info">-->
<!--                                <span class="o_stat_text">Book Details</span>-->
<!--                            </div>-->
<!--                        </button>-->

<!--                        <button class="oe_stat_button" type="object"-->
<!--                                name="action_view_member_details" icon="fa-user"-->
<!--                                attrs="{'invisible': [('member_id', '=', False)]}">-->
<!--                            <div class="o_field_widget o_stat_info">-->
<!--                                <span class="o_stat_text">Member Details</span>-->
<!--                            </div>-->
<!--                        </button>-->

                        <!-- Overdue Ribbon -->
                        <widget name="web_ribbon" title="Overdue" bg_color="bg-danger"/>

                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name" readonly="1"/></h1>
                        </div>

                        <group>
                            <group name="borrowing_info" string="Borrowing Information">
                                <field name="book_id" options="{'no_create': True, 'no_create_edit': True}"
                                       domain="[('state', '=', 'available')]"/>
                                <field name="member_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="borrow_date"/>
                                <field name="due_date"/>
                                <field name="issued_by" readonly="1"/>
                            </group>
                            <group name="book_details" string="Book Details">
                                <field name="book_name" readonly="1"/>
                                <field name="book_author" readonly="1"/>
                                <field name="book_isbn" readonly="1"/>
                                <field name="condition_on_borrow"/>
                            </group>
                        </group>

                        <group>
                            <group name="member_details" string="Member Details">
                                <field name="member_name" readonly="1"/>
                                <field name="member_type" readonly="1"/>
                            </group>
                            <group name="return_info" string="Return Information">
                                <field name="actual_return_date" readonly="1"/>
                                <field name="returned_by" readonly="1"/>
                                <field name="condition_on_return" readonly="1"/>
                                <field name="days_borrowed" readonly="1"/>
                            </group>
                        </group>

                        <group>
                            <group name="overdue_info" string="Overdue Information">
                                <field name="is_overdue" readonly="1"/>
                                <field name="overdue_days" readonly="1"/>
                                <field name="fine_amount" readonly="1"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Rating &amp; Review" name="review">
                                <group>
                                    <field name="rating"/>
                                    <field name="review" placeholder="Member's review of the book..."/>
                                </group>
                            </page>
                            <page string="Notes" name="notes">
                                <field name="notes" placeholder="Additional notes about this borrowing..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Borrow Tree View -->
        <record id="view_library_borrow_tree" model="ir.ui.view">
            <field name="name">library.borrow.tree</field>
            <field name="model">library.borrow</field>
            <field name="arch" type="xml">
                <tree string="Book Borrowing" decoration-info="state=='borrowed'"
                      decoration-danger="state=='overdue'"
                      decoration-success="state=='returned'"
                      decoration-muted="state in ['cancelled']">
                    <field name="name"/>
                    <field name="book_id"/>
                    <field name="member_id"/>
                    <field name="borrow_date"/>
                    <field name="due_date"/>
                    <field name="actual_return_date"/>
                    <field name="overdue_days"/>
                    <field name="fine_amount"/>
                    <field name="state" widget="badge"/>
                    <field name="is_overdue" invisible="1"/>
                </tree>
            </field>
        </record>

        <!-- Borrow Search View -->
        <record id="view_library_borrow_search" model="ir.ui.view">
            <field name="name">library.borrow.search</field>
            <field name="model">library.borrow</field>
            <field name="arch" type="xml">
                <search string="Search Book Borrowing">
                    <field name="name" string="Borrowing Reference"/>
                    <field name="book_id"/>
                    <field name="member_id"/>
                    <field name="issued_by"/>
                    <field name="borrow_date"/>
                    <field name="due_date"/>

                    <filter string="My Issued Books" name="my_issued"
                            domain="[('issued_by', '=', uid)]"/>
                    <filter string="Currently Borrowed" name="borrowed"
                            domain="[('state', '=', 'borrowed')]"/>
                    <filter string="Overdue Books" name="overdue"
                            domain="[('state', '=', 'overdue')]"/>
                    <filter string="Returned Books" name="returned"
                            domain="[('state', '=', 'returned')]"/>

                    <separator/>
                    <filter string="This Month" name="this_month"
                            domain="[('borrow_date', '&gt;=', (context_today() - relativedelta(months=1)).strftime('%Y-%m-01'))]"/>
                    <filter string="This Year" name="this_year"
                            domain="[('borrow_date', '&gt;=', (context_today()).strftime('%Y-01-01'))]"/>

                    <separator/>
<!--                    <filter string="With Fine" name="with_fine" domain="[('fine_amount','&gt;',0)]"/>-->

                    <group expand="0" string="Group By">
                        <filter string="State" name="group_by_state"
                                context="{'group_by': 'state'}"/>
                        <filter string="Book" name="group_by_book"
                                context="{'group_by': 'book_id'}"/>
                        <filter string="Member" name="group_by_member"
                                context="{'group_by': 'member_id'}"/>
                        <filter string="Issued By" name="group_by_issued_by"
                                context="{'group_by': 'issued_by'}"/>
                        <filter string="Borrow Date" name="group_by_borrow_date"
                                context="{'group_by': 'borrow_date:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Borrow Kanban View -->
        <record id="view_library_borrow_kanban" model="ir.ui.view">
            <field name="name">library.borrow.kanban</field>
            <field name="model">library.borrow</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column">
                    <field name="name"/>
                    <field name="book_id"/>
                    <field name="member_id"/>
                    <field name="borrow_date"/>
                    <field name="due_date"/>
                    <field name="state"/>
                    <field name="is_overdue"/>
                    <field name="overdue_days"/>
                    <field name="fine_amount"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <div><strong>Book:</strong> <field name="book_id"/></div>
                                        <div><strong>Member:</strong> <field name="member_id"/></div>
                                        <div><strong>Borrowed:</strong> <field name="borrow_date"/></div>
                                        <div><strong>Due:</strong> <field name="due_date"/></div>
                                        <div t-if="record.is_overdue.raw_value" class="text-danger">
                                            <strong>Overdue:</strong> <field name="overdue_days"/> days
                                        </div>
                                        <div t-if="record.fine_amount.raw_value &gt; 0" class="text-warning">
                                            <strong>Fine:</strong> <field name="fine_amount"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Action Window -->
        <record id="action_library_borrow" model="ir.actions.act_window">
            <field name="name">Book Borrowing</field>
            <field name="res_model">library.borrow</field>
            <field name="view_mode">tree,form,kanban</field>
            <field name="search_view_id" ref="view_library_borrow_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first book borrowing record!
                </p>
                <p>
                    Track book borrowing, returns, and manage overdue books with fines.
                </p>
            </field>
        </record>

        <!-- Menus -->
        <menuitem id="menu_library_borrowing"
                  name="Borrowing"
                  parent="menu_library_root"
                  sequence="30"/>

        <menuitem id="menu_library_borrow_all"
                  name="All Borrowing"
                  parent="menu_library_borrowing"
                  action="action_library_borrow"
                  sequence="4"/>
    </data>
</odoo>
