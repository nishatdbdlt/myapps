<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_library_author_tree" model="ir.ui.view">
        <field name="name">library.author.tree</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <tree string="Authors">
                <field name="name"/>
                <field name="nationality"/>
                <field name="birth_day"/>
                <field name="death_date"/>
                <field name="book_count"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_library_author_form" model="ir.ui.view">
        <field name="name">library.author.form</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <form string="Author">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="biography"/>
                        <field name="birth_day"/>
                        <field name="death_date"/>
                        <field name="nationality"/>
                        <field name="email"/>
                        <field name="website"/>
                        <field name="image"/>
                        <field name="active"/>
                        <field name="book_count" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Books">
                            <field name="books_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="category_id"/>
                                    <field name="date_release"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_library_author" model="ir.actions.act_window">
        <field name="name">Authors</field>
        <field name="res_model">library.author</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_library_root" name="Library"/>
    <menuitem id="menu_library_author" name="Authors" parent="menu_library_root" action="action_library_author"/>
</odoo>
