<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree view -->
    <record id="view_library_member_tree" model="ir.ui.view">
        <field name="name">library.member.tree</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <tree string="Library Members" decoration-muted="not active">
                <field name="member_id"/>
                <field name="name"/>
                <field name="member_type"/>
                <field name="email"/>
                <field name="mobile"/>
                <field name="membership_date"/>
                <field name="expiry_date"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_library_member_form" model="ir.ui.view">
        <field name="name">library.member.form</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <form string="Library Member">
                <sheet>
                    <group>
                        <field name="member_id" readonly="1"/>
                        <field name="name"/>
                        <field name="member_type"/>
                        <field name="email"/>
                        <field name="mobile"/>
                        <field name="date_of_birth"/>
                    </group>
                    <group>
                        <field name="membership_date"/>
                        <field name="expiry_date"/>
                        <field name="active"/>
                        <field name="blocked"/>
                    </group>
                    <notebook>
                        <page string="Address">
                            <group>
                                <field name="street"/>
                                <field name="street2"/>
                                <field name="city"/>
                                <field name="state"/>
                                <field name="zip_code"/>
                                <field name="country_id"/>
                            </group>
                        </page>
                        <page string="Statistics">
                            <group>
                                <field name="total_borrowed" readonly="1"/>
                                <field name="current_borrowed" readonly="1"/>
                                <field name="books_overdue" readonly="1"/>
                                <field name="total_fines" readonly="1"/>
                                <field name="unpaid_fines" readonly="1"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>

                <footer>
                    <button name="action_renew_membership" type="object" string="Renew Membership" class="btn-primary"/>
                    <button name="action_block_member" type="object" string="Block Member" class="btn-warning"/>
                    <button name="action_unblock_member" type="object" string="Unblock" class="btn-secondary"/>
                    <button name="action_view_borrowed_books" type="object" string="View Borrowed Books" class="btn-info"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_library_member" model="ir.actions.act_window">
        <field name="name">Library Members</field>
        <field name="res_model">library.member</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create library members here.
            </p>
        </field>
    </record>

    <!-- Menu (under your Library root menu) -->
    <menuitem id="menu_library_root" name="Library"/>
    <menuitem id="menu_library_members" name="Members" parent="menu_library_root" action="action_library_member"/>

</odoo>
