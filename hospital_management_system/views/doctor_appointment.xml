<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_hospital_appointment_tree" model="ir.ui.view">
            <field name="name">hospital.appointment.tree</field>
            <field name="model">hospital.appointment</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="patient_id"/>
                    <field name="doctor_id"/>
                    <field name="appointment_date"/>
                    <field name="duration"/>
<!--                    <field name="consultation_fee"/>-->
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_hospital_appointment_form" model="ir.ui.view">
            <field name="name">hospital.appointment.form</field>
            <field name="model">hospital.appointment</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
<!--                            <field name="department_id"/>-->
                            <field name="appointment_date"/>
                            <field name="duration"/>
<!--                            <field name="consultation_fee"/>-->
                            <field name="is_paid"/>
                        </group>
                        <notebook>
                            <page string="Details">
                                <group>
                                    <field name="reason"/>
                                    <field name="notes"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Calendar View -->
        <record id="view_hospital_appointment_calendar" model="ir.ui.view">
            <field name="name">hospital.appointment.calendar</field>
            <field name="model">hospital.appointment</field>
            <field name="arch" type="xml">
                <calendar string="Appointments" date_start="appointment_date">
                    <field name="patient_id"/>
                    <field name="doctor_id"/>
                </calendar>
            </field>
        </record>

        <!-- Action -->
        <record id="action_hospital_appointment" model="ir.actions.act_window">
            <field name="name">Appointments</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hospital.appointment</field>
            <field name="view_mode">tree,form,calendar</field>
        </record>

        <!-- Menu -->
        <menuitem id="menu_hospital_root" name="Hospital"/>
        <menuitem id="menu_hospital_appointments" name="Appointments" parent="menu_hospital_root" action="action_hospital_appointment"/>
    </data>
</odoo>
