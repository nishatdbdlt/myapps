<odoo>
    <data>

        <!-- Tree View -->
        <record id="view_hospital_doctor_tree" model="ir.ui.view">
            <field name="name">hospital.doctor.tree</field>
            <field name="model">hospital.doctor</field>
            <field name="arch" type="xml">
                <tree string="Doctors">
                    <field name="doctor_id"/>
                    <field name="name"/>
                    <field name="specialization"/>
                    <field name="department_id"/>
                    <field name="phone"/>
                    <field name="email"/>
                    <field name="consultation_fee"/>
<!--                    <field name="available_days"/>-->
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_hospital_doctor_form" model="ir.ui.view">
            <field name="name">hospital.doctor.form</field>
            <field name="model">hospital.doctor</field>
            <field name="arch" type="xml">
                <form string="Doctor">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="available,busy,on_leave"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="doctor_id" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="specialization"/>
                                <field name="department_id"/>
                                <field name="qualification"/>
                                <field name="experience_years"/>
                            </group>
                            <group>
                                <field name="phone"/>
                                <field name="email" widget="email"/>
                                <field name="license_number"/>
                                <field name="consultation_fee"/>
                            </group>
                        </group>
                        <group string="Address">
                            <field name="address" nolabel="1"/>
                        </group>
                        <group string="Availability">
                            <group>
                                <field name="available_days"/>
                                <field name="available_time_from" widget="float_time"/>
                                <field name="available_time_to" widget="float_time"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Appointments">
                                <field name="appointment_ids">
                                    <tree string="Appointments" editable="bottom">
                                        <field name="name"/>
                                        <field name="patient_id"/>
                                        <field name="appointment_date"/>
<!--                                        <field name="appointment_time"/>-->
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_hospital_doctor_search" model="ir.ui.view">
            <field name="name">hospital.doctor.search</field>
            <field name="model">hospital.doctor</field>
            <field name="arch" type="xml">
                <search string="Search Doctors">
                    <field name="name" string="Doctor Name" filter_domain="[('name','ilike',self)]"/>
                    <field name="doctor_id" string="Doctor ID"/>
                    <field name="specialization" string="Specialization"/>
                    <field name="department_id" string="Department"/>
                    <separator/>
                    <filter string="Available" name="available" domain="[('state','=','available')]"/>
                    <filter string="Busy" name="busy" domain="[('state','=','busy')]"/>
                    <filter string="On Leave" name="on_leave" domain="[('state','=','on_leave')]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Department" name="group_department" context="{'group_by':'department_id'}"/>
                        <filter string="Specialization" name="group_specialization" context="{'group_by':'specialization'}"/>
                        <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Kanban View -->
        <record id="view_hospital_doctor_kanban" model="ir.ui.view">
            <field name="name">hospital.doctor.kanban</field>
            <field name="model">hospital.doctor</field>
            <field name="arch" type="xml">
                <kanban string="Doctors">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="doctor_id"/>
                    <field name="specialization"/>
                    <field name="department_id"/>
                    <field name="phone"/>
                    <field name="email"/>
                    <field name="state"/>
                    <field name="consultation_fee"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click">
                                <div class="o_kanban_image">
                                    <img alt="Doctor" t-att-src="kanban_image('hospital.doctor', 'image_128', record.id.raw_value)"/>
                                </div>
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="doctor_id"/>
                                    </div>
                                    <div>
                                        <field name="specialization"/>
                                    </div>
                                    <div>
                                        <field name="department_id"/>
                                    </div>
                                    <div t-if="record.phone.raw_value">
                                        <field name="phone"/>
                                    </div>
                                    <div t-if="record.email.raw_value">
                                        <i class="fa fa-envelope" title="email"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="state" widget="label_selection" options="{'classes': {'available': 'success', 'busy': 'warning', 'on_leave': 'danger'}}"/>
                                    </div>
                                    <div class="oe_kanban_bottom_left">
                                        <span>Fee: $<field name="consultation_fee"/></span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Action -->
        <record id="action_hospital_doctor" model="ir.actions.act_window">
            <field name="name">Doctors</field>
            <field name="res_model">hospital.doctor</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first doctor!
                </p>
                <p>
                    Add doctors to your hospital system to manage appointments and patient care.
                </p>
            </field>
        </record>

        <!-- Menu Items -->
        <menuitem id="menu_hospital_doctor"
                  name="Doctors"
                  parent="menu_hospital_root"
                  action="action_hospital_doctor"
                  sequence="10"/>

</data>
</odoo>