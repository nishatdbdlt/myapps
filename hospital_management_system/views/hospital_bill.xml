<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree view for Hospital Bills -->
    <record id="view_hospital_bill_tree" model="ir.ui.view">
        <field name="name">hospital.bill.tree</field>
        <field name="model">hospital.bill</field>
        <field name="arch" type="xml">
            <tree string="Hospital Bills">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="bill_date"/>
                <field name="subtotal"/>
                <field name="tax_amount"/>
                <field name="total_amount"/>
                <field name="state"/>
            </tree>
        </field>
    </record>F

    <!-- Form view for Hospital Bills -->
    <record id="view_hospital_bill_form" model="ir.ui.view">
        <field name="name">hospital.bill.form</field>
        <field name="model">hospital.bill</field>
        <field name="arch" type="xml">
            <form string="Hospital Bill">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="patient_id"/>
                        <field name="bill_date"/>
                        <field name="state" readonly="1"/>
                    </group>

                    <notebook>
                        <page string="Bill Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="total" readonly="1"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Totals">
                            <group>
                                <field name="subtotal" readonly="1"/>
                                <field name="tax_amount" readonly="1"/>
                                <field name="total_amount" readonly="1"/>
                            </group>
                        </page>
                    </notebook>

                    <footer>
                        <button string="Confirm" type="object" name="action_confirm"
                                class="btn-primary"/>
                        <button string="Pay" type="object" name="action_pay"
                                 class="btn-success"/>
<!--                        <button string="Cancel" type="object" name="action_cancel"-->
<!--                                states="draft,confirmed" class="btn-danger"/>-->
<!--                        <button string="Reset to Draft" type="object" name="action_reset"-->
<!--                                states="cancelled" class="btn-secondary"/>-->
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for Hospital Bills -->
    <record id="action_hospital_bill" model="ir.actions.act_window">
        <field name="name">Hospital Bills</field>
        <field name="res_model">hospital.bill</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a new hospital bill.
            </p>
        </field>
    </record>

    <!-- Menu item -->
    <menuitem id="menu_hospital_root" name="Hospital Management"/>
    <menuitem id="menu_hospital_bill" name="Bills" parent="menu_hospital_root" action="action_hospital_bill"/>
</odoo>
