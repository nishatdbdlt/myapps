<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Bidding menu to portal -->
    <template id="portal_my_home_menu_bidding" name="Portal My Home : Bidding" inherit_id="portal.portal_my_home" priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Bidding Records</t>
                <t t-set="url" t-value="'/my/bidding'"/>
                <t t-set="placeholder_count" t-value="'bidding_count'"/>
            </t>
        </xpath>
    </template>

    <!-- Bidding List Page -->
    <template id="portal_my_bidding" name="My Bidding Records">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Bidding Records</t>
            </t>

            <div class="container mt-3">
                <div class="row mb-3">
                    <div class="col-12">
                        <a href="/my/bidding/create" class="btn btn-primary">
                            <i class="fa fa-plus"/> Create New Bidding
                        </a>
                    </div>
                </div>

                <t t-if="request.params.get('message') == 'success'">
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        Bidding record created successfully!
                        <button type="button" class="close" data-dismiss="alert">times;</button>
                    </div>
                </t>

                <t t-if="request.params.get('message') == 'deleted'">
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        Bidding record deleted successfully!
                        <button type="button" class="close" data-dismiss="alert">times;</button>
                    </div>
                </t>

                <div class="row">
                    <div class="col-12">
                        <table class="table table-striped table-hover">
                            <thead class="thead-light">
                                <tr>
                                    <th>Client Name</th>
                                    <th>Company</th>
                                    <th>Bidding Amount</th>
                                    <th>Service Type</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="not bidding_records">
                                    <tr>
                                        <td colspan="7" class="text-center text-muted">No bidding records found</td>
                                    </tr>
                                </t>
                                <t t-foreach="bidding_records" t-as="bidding">
                                    <tr>
                                        <td><t t-esc="bidding.client_name"/></td>
                                        <td><t t-esc="bidding.Sbus_id"/></td>
                                        <td><t t-esc="bidding.bidding_amount"/></td>
                                        <td><t t-esc="bidding.Service_type"/></td>
                                        <td>
                                            <span t-if="bidding.bidding_status == 'draft'" class="badge badge-secondary">Draft</span>
                                            <span t-if="bidding.bidding_status == 'submitted'" class="badge badge-info">Submitted</span>
                                            <span t-if="bidding.bidding_status == 'won'" class="badge badge-success">Won</span>
                                            <span t-if="bidding.bidding_status == 'lost'" class="badge badge-danger">Lost</span>
                                        </td>
                                        <td><t t-esc="bidding.date"/></td>
                                        <td>
                                            <a t-attf-href="/my/bidding/{{bidding.id}}" class="btn btn-sm btn-info">
                                                <i class="fa fa-eye"/> View
                                            </a>
                                            <a t-attf-href="/my/bidding/edit/{{bidding.id}}" class="btn btn-sm btn-warning">
                                                <i class="fa fa-edit"/> Edit
                                            </a>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Bidding Create Form -->
    <template id="portal_bidding_create_form" name="Create Bidding">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <div class="row">
                    <div class="col-lg-8 offset-lg-2">
                        <h2 class="mb-4">Create New Bidding</h2>

                        <t t-if="request.params.get('error')">
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                Error: <t t-esc="request.params.get('error')"/>
                                <button type="button" class="close" data-dismiss="alert">times;</button>
                            </div>
                        </t>

                        <form action="/my/bidding/submit" method="POST" class="card p-4">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                            <div class="form-group">
                                <label for="client_user">Client User Name</label>
                                <input type="text" class="form-control" id="client_user" name="client_user" required="required"/>
                            </div>

                            <div class="form-group">
                                <label for="user_code">User ID</label>
                                <input type="text" class="form-control" id="user_code" name="user_code" required="required"/>
                            </div>

                            <div class="form-group">
                                <label for="client_name">Client Display Name</label>
                                <input type="text" class="form-control" id="client_name" name="client_name" required="required"/>
                            </div>

                            <div class="form-group">
                                <label for="Sbus_id">Company Name</label>
                                <input type="text" class="form-control" id="Sbus_id" name="Sbus_id"/>
                            </div>

                            <div class="form-group">
                                <label for="bidding_amount">Bidding Amount</label>
                                <input type="text" class="form-control" id="bidding_amount" name="bidding_amount"/>
                            </div>

                            <div class="form-group">
                                <label for="date">Date</label>
                                <input type="date" class="form-control" id="date" name="date"/>
                            </div>

                            <div class="form-group">
                                <label for="Service_type">Service Type</label>
                                <input type="text" class="form-control" id="Service_type" name="Service_type"/>
                            </div>

                            <div class="form-group">
                                <label for="bidding_status">Bidding Status</label>
                                <select class="form-control" id="bidding_status" name="bidding_status">
                                    <option value="draft">Draft</option>
                                    <option value="submitted">Submitted</option>
                                    <option value="won">Won</option>
                                    <option value="lost">Lost</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="payment_status">Payment Status</label>
                                <select class="form-control" id="payment_status" name="payment_status">
                                    <option value="">-- Select --</option>
                                    <option value="sold">Sold</option>
                                    <option value="unsold">Unsold</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="client_category">Client Category</label>
                                <select class="form-control" id="client_category" name="client_category">
                                    <option value="">-- Select --</option>
                                    <option value="new">New</option>
                                    <option value="existing">Existing</option>
                                    <option value="vip">VIP</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="quote_category">Quote Category</label>
                                <select class="form-control" id="quote_category" name="quote_category">
                                    <option value="">-- Select --</option>
                                    <option value="fixed">Fixed Price</option>
                                    <option value="hourly">Hourly</option>
                                    <option value="milestone">Milestone Based</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="profile">Profile Name</label>
                                <input type="text" class="form-control" id="profile" name="profile"/>
                            </div>

                            <div class="form-group mt-4">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa fa-check"/> Submit
                                </button>
                                <a href="/my/bidding" class="btn btn-secondary">
                                    <i class="fa fa-times"/> Cancel
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Bidding Detail Page -->
    <template id="portal_bidding_detail" name="Bidding Detail">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <div class="row">
                    <div class="col-lg-8 offset-lg-2">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h2>Bidding Details</h2>
                            <div>
                                <a t-attf-href="/my/bidding/edit/{{bidding.id}}" class="btn btn-warning">
                                    <i class="fa fa-edit"/> Edit
                                </a>
                                <a href="/my/bidding" class="btn btn-secondary">
                                    <i class="fa fa-arrow-left"/> Back to List
                                </a>
                            </div>
                        </div>

                        <t t-if="request.params.get('message') == 'updated'">
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                Bidding record updated successfully!
                                <button type="button" class="close" data-dismiss="alert">times;</button>
                            </div>
                        </t>

                        <div class="card">
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <strong>Client User Name:</strong>
                                        <p><t t-esc="bidding.client_user"/></p>
                                    </div>
                                    <div class="col-md-6">
                                        <strong>User ID:</strong>
                                        <p><t t-esc="bidding.user_code"/></p>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <strong>Client Display Name:</strong>
                                        <p><t t-esc="bidding.client_name"/></p>
                                    </div>
                                    <div class="col-md-6">
                                        <strong>Company Name:</strong>
                                        <p><t t-esc="bidding.Sbus_id"/></p>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <strong>Bidding Amount:</strong>
                                        <p><t t-esc="bidding.bidding_amount"/></p>
                                    </div>
                                    <div class="col-md-6">
                                        <strong>Date:</strong>
                                        <p><t t-esc="bidding.date"/></p>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <strong>Service Type:</strong>
                                        <p><t t-esc="bidding.Service_type"/></p>
                                    </div>
                                    <div class="col-md-6">
                                        <strong>Profile Name:</strong>
                                        <p><t t-esc="bidding.profile"/></p>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <strong>Bidding Status:</strong>
                                        <p>
                                            <span t-if="bidding.bidding_status == 'draft'" class="badge badge-secondary">Draft</span>
                                            <span t-if="bidding.bidding_status == 'submitted'" class="badge badge-info">Submitted</span>
                                            <span t-if="bidding.bidding_status == 'won'" class="badge badge-success">Won</span>
                                            <span t-if="bidding.bidding_status == 'lost'" class="badge badge-danger">Lost</span>
                                        </p>
                                    </div>
                                    <div class="col-md-4">
                                        <strong>Payment Status:</strong>
                                        <p><t t-esc="dict(bidding._fields['payment_status'].selection).get(bidding.payment_status, '')"/></p>
                                    </div>
                                    <div class="col-md-4">
                                        <strong>Client Category:</strong>
                                        <p><t t-esc="dict(bidding._fields['client_category'].selection).get(bidding.client_category, '')"/></p>
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <strong>Quote Category:</strong>
                                        <p><t t-esc="dict(bidding._fields['quote_category'].selection).get(bidding.quote_category, '')"/></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Bidding Edit Form -->
    <template id="portal_bidding_edit_form" name="Edit Bidding">
        <t t-call="portal.portal_layout">
            <div class="container mt-4">
                <div class="row">
                    <div class="col-lg-8 offset-lg-2">
                        <h2 class="mb-4">Edit Bidding</h2>

                        <t t-if="request.params.get('error')">
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                Error: <t t-esc="request.params.get('error')"/>
                                <button type="button" class="close" data-dismiss="alert">times;</button>
                            </div>
                        </t>

                        <form t-attf-action="/my/bidding/update/{{bidding.id}}" method="POST" class="card p-4">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                            <div class="form-group">
                                <label for="client_user">Client User Name</label>
                                <input type="text" class="form-control" id="client_user" name="client_user" t-att-value="bidding.client_user" required="required"/>
                            </div>

                            <div class="form-group">
                                <label for="user_code">User ID</label>
                                <input type="text" class="form-control" id="user_code" name="user_code" t-att-value="bidding.user_code" required="required"/>
                            </div>

                            <div class="form-group">
                                <label for="client_name">Client Display Name</label>
                                <input type="text" class="form-control" id="client_name" name="client_name" t-att-value="bidding.client_name" required="required"/>
                            </div>

                            <div class="form-group">
                                <label for="Sbus_id">Company Name</label>
                                <input type="text" class="form-control" id="Sbus_id" name="Sbus_id" t-att-value="bidding.Sbus_id"/>
                            </div>

                            <div class="form-group">
                                <label for="bidding_amount">Bidding Amount</label>
                                <input type="text" class="form-control" id="bidding_amount" name="bidding_amount" t-att-value="bidding.bidding_amount"/>
                            </div>

                            <div class="form-group">
                                <label for="date">Date</label>
                                <input type="date" class="form-control" id="date" name="date" t-att-value="bidding.date"/>
                            </div>

                            <div class="form-group">
                                <label for="Service_type">Service Type</label>
                                <input type="text" class="form-control" id="Service_type" name="Service_type" t-att-value="bidding.Service_type"/>
                            </div>

                            <div class="form-group">
                                <label for="bidding_status">Bidding Status</label>
                                <select class="form-control" id="bidding_status" name="bidding_status">
                                    <option value="draft" t-att-selected="'selected' if bidding.bidding_status == 'draft' else None">Draft</option>
                                    <option value="submitted" t-att-selected="'selected' if bidding.bidding_status == 'submitted' else None">Submitted</option>
                                    <option value="won" t-att-selected="'selected' if bidding.bidding_status == 'won' else None">Won</option>
                                    <option value="lost" t-att-selected="'selected' if bidding.bidding_status == 'lost' else None">Lost</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="payment_status">Payment Status</label>
                                <select class="form-control" id="payment_status" name="payment_status">
                                    <option value="">-- Select --</option>
                                    <option value="sold" t-att-selected="'selected' if bidding.payment_status == 'sold' else None">Sold</option>
                                    <option value="unsold" t-att-selected="'selected' if bidding.payment_status == 'unsold' else None">Unsold</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="client_category">Client Category</label>
                                <select class="form-control" id="client_category" name="client_category">
                                    <option value="">-- Select --</option>
                                    <option value="new" t-att-selected="'selected' if bidding.client_category == 'new' else None">New</option>
                                    <option value="existing" t-att-selected="'selected' if bidding.client_category == 'existing' else None">Existing</option>
                                    <option value="vip" t-att-selected="'selected' if bidding.client_category == 'vip' else None">VIP</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="quote_category">Quote Category</label>
                                <select class="form-control" id="quote_category" name="quote_category">
                                    <option value="">-- Select --</option>
                                    <option value="fixed" t-att-selected="'selected' if bidding.quote_category == 'fixed' else None">Fixed Price</option>
                                    <option value="hourly" t-att-selected="'selected' if bidding.quote_category == 'hourly' else None">Hourly</option>
                                    <option value="milestone" t-att-selected="'selected' if bidding.quote_category == 'milestone' else None">Milestone Based</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="profile">Profile Name</label>
                                <input type="text" class="form-control" id="profile" name="profile" t-att-value="bidding.profile"/>
                            </div>

                            <div class="form-group mt-4">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa fa-check"/> Update
                                </button>
                                <a t-attf-href="/my/bidding/{{bidding.id}}" class="btn btn-secondary">
                                    <i class="fa fa-times"/> Cancel
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>