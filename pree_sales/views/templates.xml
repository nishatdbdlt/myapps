            </field>
        </record>

        <!-- GRAPH VIEW: Analytics for Pre-Sales -->
        <record id="view_res_partner_graph_pre_sales" model="ir.ui.view">
            <field name="name">res.partner.graph.pre.sales</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <graph string="Pre Sales Analysis" type="bar">
<!--                    <field name="service_type"/>-->
                    <field name="bidding_amount"/>
                </graph>
            </field>
        </record>

        <!-- PIVOT VIEW: Pivot Table for Pre-Sales (Optional but useful) -->
        <record id="view_res_partner_pivot_pre_sales" model="ir.ui.view">
            <field name="name">res.partner.pivot.pre.sales</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <pivot string="Pre Sales Pivot" sample="1">
<!--                    <field name="service_type"/>-->
                    <!-- <field name="bidding_status" type="col"/> -->
                    <!-- <field name="client_category" type="row"/> -->
                    <field name="bidding_amount"/>
                </pivot>
            </field>
        </record>



        <!-- SEARCH VIEW: Enhanced Search and Filters -->
        <record id="view_res_partner_search_pre_sales" model="ir.ui.view">
            <field name="name">res.partner.search.pre.sales</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <search string="Pre Sales Search">
                    <!-- Search Fields -->
                    <field name="name"/>
<!--                    <field name="service_type"/>-->
                    <!-- <field name="client_category"/> -->


                    <!-- Filters -->
                    <filter string="High Value (>100k)" name="high_value"
                            domain="[('bidding_amount','>',100000)]"/>
                    <filter string="Low Value (≤100k)" name="low_value"
                            domain="[('bidding_amount','&lt;=',100000)]"/>

                    <separator/>
                    <!-- <filter string="Won" name="won"
                            domain="[('bidding_status','=','won')]"/>
                    <filter string="In Progress" name="in_progress"
                            domain="[('bidding_status','=','in_progress')]"/>
                    <filter string="Lost" name="lost"
                            domain="[('bidding_status','=','lost')]"/> -->

                    <separator/>
<!--                    <filter string="Paid" name="paid" -->
<!--                            domain="[('payment_status','=','paid')]"/>-->
<!--                    <filter string="Pending" name="pending" -->
<!--                            domain="[('payment_status','=','pending')]"/>-->
<!--                    -->
                    <!-- Group By -->
                    <!-- <group expand="0" string="Group By">
                        <filter string="Service Type" name="group_service_type"
                                context="{'group_by':'service_type'}"/>
                        <filter string="Bidding Status" name="group_bidding_status"
                                context="{'group_by':'bidding_status'}"/>
                        <filter string="Client Category" name="group_client_category"
                                context="{'group_by':'client_category'}"/>
                        <filter string="Payment Status" name="group_payment_status"
                                context="{'group_by':'payment_status'}"/>
                        <filter string="Date" name="group_date"
                                context="{'group_by':'date'}"/>
                    </group> -->
                </search>
            </field>
        </record>

        <!-- ACTION: Configure all views -->
        <record id="action_res_partner_pre_sales" model="ir.actions.act_window">
            <field name="name">Pre Sales</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">tree,form,graph,pivot</field>
            <field name="search_view_id" ref="view_res_partner_search_pre_sales"/>
            <field name="context">{
                'search_default_group_service_type': 1
            }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first Pre Sales record
                </p>
                <p>
                    Track bidding information, client details, and service types for your pre-sales process.
                </p>
            </field>
        </record>



        <record id="action_res_partner_pre_sales_view_tree" model="ir.actions.act_window.view">
            <field name="sequence" eval="2"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_res_partner_tree_pre_sales"/>
            <field name="act_window_id" ref="action_res_partner_pre_sales"/>
        </record>

        <record id="action_res_partner_pre_sales_view_form" model="ir.actions.act_window.view">
            <field name="sequence" eval="3"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_res_partner_form_inherit_bidding"/>
            <field name="act_window_id" ref="action_res_partner_pre_sales"/>
        </record>

        <record id="action_res_partner_pre_sales_view_graph" model="ir.actions.act_window.view">
            <field name="sequence" eval="4"/>
            <field name="view_mode">graph</field>
            <field name="view_id" ref="view_res_partner_graph_pre_sales"/>
            <field name="act_window_id" ref="action_res_partner_pre_sales"/>
        </record>

        <record id="action_res_partner_pre_sales_view_pivot" model="ir.actions.act_window.view">
            <field name="sequence" eval="5"/>
            <field name="view_mode">pivot</field>
            <field name="view_id" ref="view_res_partner_pivot_pre_sales"/>
            <field name="act_window_id" ref="action_res_partner_pre_sales"/>
        </record>

