                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- TREE VIEW: List View for Pre-Sales -->
        <record id="view_res_partner_tree_pre_sales" model="ir.ui.view">
            <field name="name">res.partner.tree.pre.sales</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <tree string="Pre Sales">
                     <!-- <field name="sbus_id" string="company name"/> -->
