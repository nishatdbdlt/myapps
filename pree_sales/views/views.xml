<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Template: Bidding List -->
        <template id="portal_bidding_list" name="My Biddings">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>

                <t t-call="portal.portal_searchbar">
                    <t t-set="title">My Biddings</t>
                </t>

                <div class="container mt-4">
                    <div class="row">
                        <div class="col-12">
                            <!-- Debug: Show that page is loading -->
                            <div class="alert alert-warning mb-3">
                                <strong>Debug Info:</strong>
                                <p>Partners count: <t t-esc="len(partners or [])"/></p>
                                <p>User: <t t-esc="request.env.user.name"/></p>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h3>My Bidding Records</h3>
                                <a href="/my/bidding/create" class="btn btn-primary">
                                    <i class="fa fa-plus"/> Create New Bidding
                                </a>
                            </div>

                            <!-- Show message when no partners -->
                            <t t-if="not partners or len(partners) == 0">
                                <div class="alert alert-info">
                                    <h5>No Bidding Records Found</h5>
                                    <p class="mb-0">You don't have any bidding records yet. Click "Create New Bidding" to add one.</p>
                                </div>
                            </t>

                            <!-- Show table when partners exist -->
                            <t t-if="partners and len(partners) > 0">
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th>ID</th>
                                                <th>Name</th>
                                                <th>Bidding Amount</th>
                                                <th>Status</th>
                                                <th>Date Created</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="partners" t-as="partner">
                                                <tr>
                                                    <td><t t-esc="partner.id"/></td>
                                                    <td><strong><t t-esc="partner.name"/></strong></td>
                                                    <td>
                                                        <t t-if="partner.bidding_amount">
                                                            <t t-esc="'%.2f' % partner.bidding_amount"/>
                                                        </t>
                                                        <t t-else="">-</t>
                                                    </td>
                                                    <td>
                                                        <t t-if="partner.bidding_status == 'draft'">
                                                            <span class="badge bg-secondary">Draft</span>
                                                        </t>
                                                        <t t-elif="partner.bidding_status == 'submitted'">
                                                            <span class="badge bg-info text-white">Submitted</span>
                                                        </t>
                                                        <t t-elif="partner.bidding_status == 'approved'">
                                                            <span class="badge bg-success">Approved</span>
                                                        </t>
                                                        <t t-elif="partner.bidding_status == 'rejected'">
                                                            <span class="badge bg-danger">Rejected</span>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="badge bg-light text-dark"><t t-esc="partner.bidding_status or 'N/A'"/></span>
                                                        </t>
                                                    </td>
                                                    <td>
                                                        <t t-if="partner.create_date">
                                                            <t t-esc="partner.create_date.strftime('%Y-%m-%d %H:%M')"/>
                                                        </t>
                                                        <t t-else="">-</t>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Template: Bidding Form -->
        <template id="portal_bidding_form" name="Create Bidding">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>

                <t t-call="portal.portal_searchbar">
                    <t t-set="title">Create New Bidding</t>
                </t>

                <div class="container mt-4">
                    <div class="row">
                        <div class="col-lg-8 offset-lg-2">
                            <div class="card shadow-sm">
                                <div class="card-header bg-primary text-white">
                                    <h4 class="mb-0">New Bidding Information</h4>
                                </div>
                                <div class="card-body">
                                    <form action="/my/bidding/submit" method="POST" class="needs-validation" novalidate="novalidate">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                        <div class="mb-3">
                                            <label for="name" class="form-label">
                                                Bidding Name <span class="text-danger">*</span>
                                            </label>
                                            <input type="text"
                                                   class="form-control"
                                                   id="name"
                                                   name="name"
                                                   placeholder="Enter bidding name"
                                                   required="required"/>
                                            <div class="invalid-feedback">
                                                Please provide a bidding name.
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label for="bidding_amount" class="form-label">
                                                Bidding Amount <span class="text-danger">*</span>
                                            </label>
                                            <input type="number"
                                                   class="form-control"
                                                   id="bidding_amount"
                                                   name="bidding_amount"
                                                   step="0.01"
                                                   min="0"
                                                   placeholder="0.00"
                                                   required="required"/>
                                            <div class="invalid-feedback">
                                                Please provide a valid bidding amount.
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label for="bidding_status" class="form-label">
                                                Bidding Status <span class="text-danger">*</span>
                                            </label>
                                            <select class="form-select"
                                                    id="bidding_status"
                                                    name="bidding_status"
                                                    required="required">
                                                <option value="">-- Select Status --</option>
                                                <option value="draft" selected="selected">Draft</option>
                                                <option value="submitted">Submitted</option>
                                                <option value="approved">Approved</option>
                                                <option value="rejected">Rejected</option>
                                            </select>
                                            <div class="invalid-feedback">
                                                Please select a bidding status.
                                            </div>
                                        </div>

                                        <div class="d-flex justify-content-between">
                                            <a href="/my/biddings" class="btn btn-secondary">
                                                <i class="fa fa-arrow-left"/> Cancel
                                            </a>
                                            <button type="submit" class="btn btn-primary">
                                                <i class="fa fa-check"/> Submit Bidding
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Form Validation Script -->
                <script type="text/javascript">
                    (function() {
                        'use strict';
                        var forms = document.querySelectorAll('.needs-validation');
                        Array.prototype.slice.call(forms).forEach(function(form) {
                            form.addEventListener('submit', function(event) {
                                if (!form.checkValidity()) {
                                    event.preventDefault();
                                    event.stopPropagation();
                                }
                                form.classList.add('was-validated');
                            }, false);
                        });
                    })();
                </script>
            </t>
        </template>
    </data>
</odoo>