<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= FORM VIEW ================= -->
    <record id="view_res_partner_bidding_form" model="ir.ui.view">
        <field name="name">res.partner.bidding.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Bidding Information">
                    <group>
                        <group>
                            <field name="user_code"/>
                            <field name="client_user"/>
                            <field name="client_name"/>
                            <field name="Sbus_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="Service_type"/>
                            <field name="bidding_status"/>
                            <field name="payment_status"/>
                            <field name="client_category"/>
                            <field name="quote_category"/>
                            <field name="profile"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <!-- ================= TREE VIEW ================= -->
    <record id="view_res_partner_bidding_tree" model="ir.ui.view">
        <field name="name">res.partner.bidding.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree string="Bidding Clients">
                <field name="user_code"/>
                <field name="client_name"/>
                <field name="client_user"/>
                <field name="Sbus_id"/>
                <field name="Service_type"/>
                <field name="bidding_status"/>
                <field name="payment_status"/>
                <field name="client_category"/>
                <field name="quote_category"/>
                <field name="date"/>
            </tree>
        </field>
    </record>

    <!-- ================= ACTION ================= -->
    <record id="action_res_partner_bidding" model="ir.actions.act_window">
        <field name="name">Client Bidding</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_res_partner_bidding_tree"/>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <!-- ================= MENU ITEMS ================= -->
    <menuitem id="menu_crm_bidding_root"
              name="Service Bidding"
              parent="crm.crm_menu_root"
              sequence="90"/>

    <menuitem id="menu_crm_bidding_clients"
              name="Client Bidding"
              parent="menu_crm_bidding_root"
              action="action_res_partner_bidding"
              sequence="1"/>
</odoo>
