<odoo>
    <!-- Load JS in backend -->
    <template id="assets_backend" inherit_id="web.assets_backend" name="Dashboard Assets">
        <xpath expr="." position="inside">
            <script type="module" src="/dashboard/static/src/js/dashboard.js"/>
        </xpath>
    </template>

    <!-- OWL Dashboard Template -->
    <templates id="dashboard_templates" xml:space="preserve">
        <t t-name="dashboard.BetopiaKPIDashboard">
            <div class="o_employee_kpi_dashboard">

                <!-- Header -->
                <div class="dashboard-header">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="mb-0"><i class="fa fa-dashboard"/> Employee KPI Dashboard</h2>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-primary" t-on-click="toggleFilters">
                                <i class="fa fa-filter"/> Filters
                            </button>
                            <button class="btn btn-sm btn-primary" t-on-click="refreshData">
                                <i class="fa fa-refresh"/> Refresh
                            </button>
                        </div>
                    </div>

                    <!-- Filters -->
                    <div t-if="state.showFilters" class="filters-section card p-3 mb-3">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Year</label>
                                <select class="form-select" t-on-change="onYearChange" t-model="state.selectedYear">
                                    <t t-foreach="getYearOptions()" t-as="year" t-key="year">
                                        <option t-att-value="year" t-att-selected="year === state.selectedYear">
                                            <t t-esc="year"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Employee</label>
                                <select class="form-select" t-on-change="onEmployeeChange">
                                    <option value="">All Employees</option>
                                    <t t-foreach="state.employees" t-as="emp" t-key="emp.id">
                                        <option t-att-value="emp.id">
                                            <t t-esc="emp.name"/> - <t t-esc="emp.role_name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Role Type</label>
                                <select class="form-select" t-on-change="onRoleTypeChange">
                                    <option value="">All Types</option>
                                    <option value="sale">Sales</option>
                                    <option value="operation">Operations</option>
                                </select>
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button class="btn btn-outline-secondary w-100" t-on-click="clearFilters">
                                    <i class="fa fa-times"/> Clear
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Loading -->
                <t t-if="state.loading">
                    <div class="text-center p-5">
                        <i class="fa fa-spinner fa-spin fa-3x text-primary"/>
                        <p class="mt-3 text-muted">Loading dashboard data...</p>
                    </div>
                </t>

                <!-- Summary Cards -->
                <t t-elif="!state.loading and state.summary">
                    <div class="row g-3 mb-4">
                        <div class="col-md-3">
                            <div class="card bg-primary text-white">
                                <div class="card-body">
                                    <h6>Total Employees</h6>
                                    <h3><t t-esc="state.summary.total_employees"/></h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-success text-white">
                                <div class="card-body">
                                    <h6>Total Bonus</h6>
                                    <h3><t t-esc="formatCurrency(state.summary.total_bonus)"/></h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-danger text-white">
                                <div class="card-body">
                                    <h6>Total Penalty</h6>
                                    <h3><t t-esc="formatCurrency(state.summary.total_penalty)"/></h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-info text-white">
                                <div class="card-body">
                                    <h6>Net Amount</h6>
                                    <h3><t t-esc="formatCurrency(state.summary.net_amount)"/></h3>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>

                <!-- KPI Content -->
                <t t-else="">
                    <t t-if="state.kpiData.length === 0">
                        <div class="alert alert-info text-center">
                            <i class="fa fa-info-circle"/> No KPI data found.
                        </div>
                    </t>
                    <t t-else="">
                        <div class="dashboard-content">
                            <!-- KPI Table / Cards will go here -->
                        </div>
                    </t>
                </t>

            </div>
        </t>
    </templates>
</odoo>
